classDiagram
    class MainWindow {
        -musicMachine: MusicMachine
        -textEditor: QTextEdit*
        -playButton: QPushButton*
        -pauseButton: QPushButton*
        -stopButton: QPushButton*
        -bpmSpinBox: QSpinBox*
        -exportButton: QPushButton*
        -fileMenu: QMenu*
        +setupUI() void
        +onPlayClicked() void
        +onPauseClicked() void
        +onStopClicked() void
        +onExportClicked() void
        +onOpenFile() void
        +onSaveFile() void
    }

    class MusicMachine {
        -voices: vector~Voice~
        -globalBPM: int
        -tokenProcessor: TokenProcessor
        -audioEngine: AudioEngine
        +initialize(string text) void
        +play() void
        +pause() void
        +stop() void
        +setBPM(int bpm) void
        +adjustBPM(int delta) void
        +exportToMidi(string filepath) bool
    }

    class Voice {
        -instrument: int
        -volume: int
        -octave: int
        -initialDelay: int
        -noteQueue: queue~MidiEvent~
        -lastNote: int
        -isPlaying: bool
        +reset(int baseInstrument, int baseVolume, int baseOctave, int delay) void
        +setInstrument(int instrumentId) void
        +setVolume(int vol) void
        +setOctave(int oct) void
        +enqueueNote(int note, float duration, int volume) void
        +enqueueSilence(float duration) void
        +getNextEvent() MidiEvent
        +hasEvents() bool
    }

    class TokenProcessor {
        -mappingRules: map~char, Instruction~
        +tokenize(string input, vector~Voice~& voices) void
        +parseLine(string line, int voiceIndex, Voice& voice) void
        +parseDelay(string line) int
    }

    class AudioEngine {
        -settings: settings*
        -synth: synth*
        -adriver: adriver*
        -soundfontId: int
        -isPlaying: bool
        +initialize(string sfPath) bool
        +noteOn(int channel, int key, int velocity) void
        +noteOff(int channel, int key) void
        +programChange(int channel, int program) void
        +setChannelVolume(int channel, int volume) void
        +shutdown() void
    }

    class MidiWriter {
        -midiFile: smf::MidiFile
        +createFile() void
        +writeVoiceTrack(int trackIndex, Voice voice) void
        +save(string filepath) bool
    }

    MainWindow *-- MusicMachine : contains
    MusicMachine *-- Voice : contains 1..*
    MusicMachine *-- TokenProcessor : uses
    MusicMachine *-- AudioEngine : uses
    MusicMachine ..> MidiWriter : uses
    TokenProcessor ..> Voice : populates
    AudioEngine ..> Voice : reads
    MidiWriter ..> Voice : reads
